EXPO_PUBLIC_API_URL=http://YOUR_PC_LAN_IP:8080/api

# Key Goong Maptiles (công khai) — cùng giá trị VITE_GOONG_MAPTILES_KEY của web. Trống thì dùng nền CARTO
EXPO_PUBLIC_GOONG_MAPTILES_KEY=

# Client ID web của Google (cùng giá trị VITE_GOOGLE_CLIENT_ID của web / GOOGLE_CLIENT_ID của Backend)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
